# Copiá este archivo a .env.local (desarrollo) o cargá las variables en Vercel (producción).
# En desarrollo podés generarlo automáticamente con: pnpm run setup:dev

APP_URL=http://localhost:3000

# Postgres. Producción: cadena del pooler de Supabase (modo transacción, puerto 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/faro
# Opcional: conexión directa (puerto 5432) solo para correr migraciones.
# MIGRATION_DATABASE_URL=

# JWT propio (Ed25519). Claves PEM codificadas en base64. Generalas con: pnpm tsx scripts/setup-env.ts .env.tmp
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=k1

# 32 bytes en base64 (cifra los secretos TOTP). openssl rand -base64 32
ENCRYPTION_KEY=
# Al menos 32 caracteres aleatorios. openssl rand -base64 48
IP_HASH_SECRET=
# Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Archivos: "local" (solo desarrollo), "supabase" (bucket privado) o "database" (dentro de Postgres, sin claves extra).
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=faro-files

# Correo: "file" (desarrollo, guarda en .data/mail) o "smtp" (p. ej. Gmail con contraseña de aplicación).
MAIL_DRIVER=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tableros <tu-cuenta@gmail.com>"

# Opcional: consulta de hashes de adjuntos en VirusTotal (no sube archivos).
VIRUSTOTAL_API_KEY=
